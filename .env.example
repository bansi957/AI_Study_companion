# ==============================================================================
# AI Study Companion - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
DB=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Cache & Background Queues (Redis / BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# ------------------------------------------------------------------------------
# 5. Groq LLM Inference
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
CONCEPT_LLM_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 6. Vector Embedding Configuration (Cohere Embed v4.0)
# ------------------------------------------------------------------------------
COHERE_API_KEY=your_cohere_api_key_here
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------------------------
# 7. Document Chunking Parameters
# ------------------------------------------------------------------------------
CHUNK_TARGET_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_MAX_SIZE=1500

# ------------------------------------------------------------------------------
# 8. Cloud Storage (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 9. Firebase Admin SDK (Backend)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
# Alternative: Raw JSON string of Service Account
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# ------------------------------------------------------------------------------
# 10. Background Processing Mode
# ------------------------------------------------------------------------------
RUN_WORKER=true

# ------------------------------------------------------------------------------
# 11. Client-Side Variables (client/.env)
# ------------------------------------------------------------------------------
# VITE_API_URL=http://localhost:3000/api
# VITE_SOCKET_URL=http://localhost:3000
# VITE_FIREBASE_API_KEY=your_firebase_web_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# VITE_FIREBASE_APP_ID=your_firebase_app_id
