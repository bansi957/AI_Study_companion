# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas with Vector Search support)
DB=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Redis Cache & BullMQ Queue Broker
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
CONCEPT_LLM_MODEL=openai/gpt-oss-120b

# Cohere Vector Embedding Configuration
COHERE_API_KEY=your_cohere_api_key_here
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# Document Chunking Configuration
CHUNK_TARGET_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_MAX_SIZE=1500

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK (Authentication Verification)
# Option A: Individual credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
# Option B: Full JSON Service Account string (alternative)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# Worker Process Mode (set to "false" if running worker separately via npm run worker)
RUN_WORKER=true
